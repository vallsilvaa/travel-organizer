# Copy this file to .env.local for local development.
# Values below are safe local Supabase defaults; replace them with `supabase status` output.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-publishable-key

# Only needed to exercise the reminder crons (/api/cron/task-reminders,
# /api/cron/overdue-tasks) locally. See README.md > Environment variables
# for what each one does.
# SUPABASE_SERVICE_ROLE_KEY=
# RESEND_API_KEY=
# REMINDER_EMAIL_FROM=
# CRON_SECRET=
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Only needed to exercise web push locally. Generate a pair with
# `npx web-push generate-vapid-keys`.
# VAPID_PUBLIC_KEY=
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Only needed to exercise Sentry locally; unset means error reporting is a no-op.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
